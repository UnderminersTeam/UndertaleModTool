<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:UndertaleModToolAvalonia.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:l="clr-namespace:UndertaleModToolAvalonia"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="UndertaleModToolAvalonia.MainWindow"
        Icon="/Assets/Icon.ico"
        x:DataType="l:MainViewModel"
        Title="{Binding Title}"
        WindowState="{Binding WindowState}"
        IsEnabled="{Binding IsEnabled}">
    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem Header="_File">
                <NativeMenu>
                    <NativeMenuItem Header="_New" Command="{Binding FileNew}" Gesture="{OnPlatform 'Ctrl+N', macOS='Meta+N'}"/>
                    <NativeMenuItem Header="_Open" Command="{Binding FileOpen}" Gesture="{OnPlatform 'Ctrl+O', macOS='Meta+O'}"/>
                    <NativeMenuItem Header="_Save" Command="{Binding FileSave}" Gesture="{OnPlatform 'Ctrl+S', macOS='Meta+S'}"/>
                    <NativeMenuItem Header="_Close" Command="{Binding FileClose}"/>
                    <NativeMenuItemSeparator Header="-" />
                    <NativeMenuItem Header="_Temp run" Command="{Binding FileTempRun}" Gesture="F5"/>
                    <NativeMenuItem Header="_Run with data/project runner" Command="{Binding FileRun}" Gesture="Alt+F5"/>
                    <NativeMenuItem Header="_Run with other runner" Command="{Binding FileRunWithOther}"/>
                    <NativeMenuItemSeparator Header="-" />
                    <NativeMenuItem Header="Clear audio group cache" Command="{Binding FileClearAudioGroupCache}"/>
                    <NativeMenuItemSeparator Header="-" />
                    <NativeMenuItem Header="S_ettings" Command="{Binding FileSettings}" Gesture="F4"/>
                    <NativeMenuItem Header="_Exit" Command="{Binding FileExit}" Gesture="{OnPlatform 'Ctrl+Q', macOS='Meta+Q'}"/>
                </NativeMenu>
            </NativeMenuItem>
            <NativeMenuItem Header="_Import" IsEnabled="False">
            </NativeMenuItem>
            <NativeMenuItem Header="_Export" IsEnabled="False">
            </NativeMenuItem>
            <NativeMenuItem Header="_Tools">
                <NativeMenu>
                    <NativeMenuItem Header="_Search in code" Command="{Binding ToolsSearchInCode}" Gesture="{OnPlatform 'Ctrl+Shift+F', macOS='Meta+Shift+F'}"/>
                    <NativeMenuItem Header="Find references" Command="{Binding ToolsFindReferences}"/>
                </NativeMenu>
            </NativeMenuItem>
            <NativeMenuItem Header="_Scripts">
                <NativeMenu>
                    <NativeMenuItem Header="Run _other script" Command="{Binding ScriptsRunOtherScript}" />
                    <NativeMenuItem Header="Reload scripts list" Click="NativeMenuItem_Click_ReloadScriptsList" />
                    <NativeMenuItemSeparator Header="-" />
                </NativeMenu>
            </NativeMenuItem>
            <NativeMenuItem Header="_Project">
                <NativeMenu>
                    <NativeMenuItem Header="_New project" Command="{Binding ProjectNew}"/>
                    <NativeMenuItem Header="_Open project" Command="{Binding ProjectOpen}"/>
                    <NativeMenuItem Header="_Save project" Command="{Binding ProjectSave}"/>
                    <NativeMenuItemSeparator Header="-" />
                    <NativeMenuItem Header="_Reload project" Command="{Binding ProjectReload}"/>
                    <NativeMenuItemSeparator Header="-" />
                    <NativeMenuItem Header="_View unexported assets" Command="{Binding ProjectViewUnexportedAssets}"/>
                    <NativeMenuItemSeparator Header="-" />
                    <NativeMenuItem Header="_Close project" Command="{Binding ProjectClose}"/>
                </NativeMenu>
            </NativeMenuItem>
            <NativeMenuItem Header="_Help">
                <NativeMenu>
                    <NativeMenuItem Header="_GitHub" Command="{Binding HelpGitHub}"/>
                    <NativeMenuItem Header="_About" Command="{Binding HelpAbout}" Gesture="F1"/>
                </NativeMenu>
            </NativeMenuItem>
        </NativeMenu>
    </NativeMenu.Menu>

    <Window.KeyBindings>
        <KeyBinding Gesture="{OnPlatform 'Ctrl+N', macOS='Meta+N'}" Command="{Binding FileNew}" />
        <KeyBinding Gesture="{OnPlatform 'Ctrl+O', macOS='Meta+O'}" Command="{Binding FileOpen}" />
        <KeyBinding Gesture="{OnPlatform 'Ctrl+S', macOS='Meta+S'}" Command="{Binding FileSave}" />
        <KeyBinding Gesture="F5" Command="{Binding FileTempRun}" />
        <KeyBinding Gesture="Alt+F5" Command="{Binding FileRun}" />
        <KeyBinding Gesture="F4" Command="{Binding FileSettings}" />
        <KeyBinding Gesture="{OnPlatform 'Ctrl+Q', macOS='Meta+Q'}" Command="{Binding FileExit}" />
        <KeyBinding Gesture="{OnPlatform 'Ctrl+Shift+F', macOS='Meta+Shift+F'}" Command="{Binding ToolsSearchInCode}" />
        <KeyBinding Gesture="F1" Command="{Binding HelpAbout}" />
        <KeyBinding Gesture="{OnPlatform 'Ctrl+W', macOS='Meta+W'}" Command="{Binding Tabs.TabCloseSelected}" />
        <KeyBinding Gesture="{OnPlatform 'Ctrl+Shift+W', macOS='Meta+Shift+W'}" Command="{Binding Tabs.TabCloseAll}" />
        <KeyBinding Gesture="{OnPlatform 'Ctrl+Shift+Tab', macOS='Meta+Shift+Tab'}" Command="{Binding Tabs.TabSetToPrevious}" />
        <KeyBinding Gesture="{OnPlatform 'Ctrl+Tab', macOS='Meta+Tab'}" Command="{Binding Tabs.TabSetToNext}" />
    </Window.KeyBindings>

    <l:MainView />
</Window>
